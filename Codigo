<style>
:root{--bg:#050a12;--pn:#0b1522;--ln:#17304a;--g:#00ff9c;--c:#22d3ee;--b:#3b82f6;--tx:#d7e4f0;--mu:#7f95ab;--r:#ff5d73;--y:#fbbf24}
*{box-sizing:border-box}
html,body{width:100%;min-width:0;margin:0}
body{background:var(--bg);color:var(--tx);font:15px/1.6 system-ui,Segoe UI,Roboto,sans-serif;background-image:linear-gradient(rgba(34,211,238,.035) 1px,transparent 1px),linear-gradient(90deg,rgba(34,211,238,.035) 1px,transparent 1px);background-size:32px 32px;overflow-x:hidden}
.app{display:flex;width:100%;min-height:100vh;min-height:100dvh}
nav{width:clamp(205px,21vw,270px);flex:0 0 clamp(205px,21vw,270px);background:rgba(5,10,18,.97);border-right:1px solid var(--ln);padding:clamp(12px,1.5vw,20px);position:sticky;top:0;align-self:flex-start;height:100vh;height:100dvh;overflow-y:auto;overflow-x:hidden}
nav h1{font:700 14px monospace;color:var(--g);margin:0 0 10px;text-shadow:0 0 8px var(--g)}
nav input{width:100%;padding:9px;background:#06101b;border:1px solid var(--ln);color:var(--tx);border-radius:6px;font:13px monospace}
nav input:focus{outline:0;border-color:var(--c);box-shadow:0 0 8px rgba(34,211,238,.4)}
nav button{display:flex;gap:8px;width:100%;text-align:left;background:0;border:1px solid transparent;color:var(--tx);padding:9px;margin-top:4px;border-radius:6px;cursor:pointer;font:inherit;transition:.2s}
nav button:hover{background:#0d2033;border-color:var(--ln)}nav button.on{background:#0d2a2f;border-color:var(--g);color:var(--g)}
.bar{height:6px;background:#0d1b2b;border-radius:9px;overflow:hidden;margin:6px 0}.bar i{display:block;height:100%;width:0;background:linear-gradient(90deg,var(--b),var(--g));transition:.5s}
main{display:block;flex:1 1 auto;width:0;min-width:0;max-width:none;padding:clamp(14px,2.4vw,34px)}
.hero{width:100%;border:1px solid var(--ln);border-radius:12px;padding:22px;background:linear-gradient(135deg,#0a1a2c,#06121c);box-shadow:0 0 24px rgba(0,255,156,.08);margin-bottom:18px}
.hero h2{margin:0 0 6px;font:700 26px monospace;color:var(--g)}.hero p{color:var(--mu);margin:4px 0}
.hero .term{font:13px monospace;color:var(--c)}.cur{animation:bl 1s steps(1) infinite}@keyframes bl{50%{opacity:0}}
.stats{display:grid;width:100%;grid-template-columns:repeat(auto-fit,minmax(min(100%,180px),1fr));gap:12px;margin-top:14px}
.card{min-width:0;background:var(--pn);border:1px solid var(--ln);border-radius:10px;padding:12px;transition:.25s}.card:hover{border-color:var(--c);box-shadow:0 0 14px rgba(34,211,238,.2);transform:translateY(-2px)}
.card b{display:block;font:700 22px monospace;color:var(--c)}
.sec{animation:in .35s}@keyframes in{from{opacity:0;transform:translateY(8px)}}
h3{font:700 20px monospace;color:var(--c);margin:0 0 4px}.sub{color:var(--mu);margin:0 0 12px}
.tabs{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:12px}.tabs button{background:#08121e;border:1px solid var(--ln);color:var(--mu);padding:6px 12px;border-radius:20px;cursor:pointer;font:inherit}
.tabs button.on{color:#021;background:var(--g);border-color:var(--g)}
.it{background:var(--pn);border:1px solid var(--ln);border-left:3px solid var(--k);border-radius:8px;margin-bottom:8px}
.it.T{--k:var(--b)}.it.C{--k:var(--g)}.it.E{--k:var(--y)}.it.X{--k:var(--r)}
.it>summary{cursor:pointer;padding:10px 12px;display:flex;gap:8px;align-items:center;list-style:none}.it>summary::-webkit-details-marker{display:none}
.tag{font:700 10px monospace;padding:2px 6px;border-radius:4px;background:var(--k);color:#021}.it.X .tag{color:#fff}
.it>summary .t{flex:1;font-weight:600}.it>summary::after{content:"▾";color:var(--mu);transition:.2s}.it[open]>summary::after{transform:rotate(180deg)}
.bd{padding:2px 14px 12px}.bd ul{margin:6px 0;padding-left:20px}
pre{position:relative;background:#02070d;border:1px solid var(--ln);border-radius:8px;padding:12px 70px 12px 12px;overflow:auto;color:var(--g);font:13px monospace;margin:8px 0}
pre::before{content:"$ terminal";display:block;color:var(--mu);font-size:10px;margin-bottom:4px}
.cp{position:absolute;right:8px;top:8px;background:#0d2a2f;color:var(--g);border:1px solid var(--g);border-radius:5px;cursor:pointer;font:11px monospace;padding:3px 8px}
.ck{display:flex;gap:6px;align-items:center;color:var(--mu);font-size:13px;margin-top:8px;cursor:pointer}
table{border-collapse:collapse;width:100%;font-size:13px;margin:8px 0}th,td{border:1px solid var(--ln);padding:6px 8px;text-align:left}th{background:#0b2233;color:var(--c)}
.wrap{overflow-x:auto}.flow{display:flex;flex-wrap:wrap;gap:6px;align-items:center;margin:8px 0}.flow span{background:#0b2233;border:1px solid var(--c);border-radius:6px;padding:4px 10px;font:12px monospace}.flow em{color:var(--g);font-style:normal}
.tm{color:var(--c);cursor:pointer;border-bottom:1px dotted var(--c)}
.pend{border:1px dashed var(--y);color:var(--y);padding:8px 10px;border-radius:8px;font-size:13px;margin:8px 0}
textarea,.fi{width:100%;background:#06101b;border:1px solid var(--ln);color:var(--tx);border-radius:6px;padding:8px;font:inherit;margin:4px 0 8px}
#md{position:fixed;inset:0;background:rgba(0,0,0,.75);display:none;align-items:center;justify-content:center;padding:16px;z-index:9}#md.on{display:flex}
#md>div{background:var(--pn);border:1px solid var(--g);border-radius:12px;padding:18px;max-width:440px;box-shadow:0 0 30px rgba(0,255,156,.3)}
#md h4{margin:0 0 6px;color:var(--g);font:700 16px monospace}#md button{background:var(--g);border:0;border-radius:6px;padding:6px 14px;cursor:pointer;font-weight:700}
@media(max-width:850px){
